{
  "name": "kickoff26",
  "version": "0.1.0",
  "private": true,
  "description": "Every World Cup 2026 match in your timezone. Where to watch free in your country. Open data, no ads.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "mcp"
  ],
  "scripts": {
    "dev": "npm run build:packages && next dev",
    "build": "npm run build:packages && next build",
    "build:packages": "npm -w @kickoff26/core run build && npm -w @kickoff26/data run build",
    "start": "next start",
    "lint": "next lint",
    "build:data": "npm -w @kickoff26/data run build:data",
    "build:data:offline": "npm -w @kickoff26/data run build:data:offline",
    "validate:data": "npm -w @kickoff26/data run validate",
    "update:results": "npm -w @kickoff26/data run update:results",
    "mcp": "node mcp/server.mjs"
  },
  "dependencies": {
    "@kickoff26/core": "^0.1.0",
    "@kickoff26/data": "^0.1.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.3"
  }
}
